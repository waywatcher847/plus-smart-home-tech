@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SensorEventProtocol {

    record SwitchSensorAvro {
        boolean state;
    }

	record MotionSensorAvro {
		int link_quality;
		boolean motion;
		int voltage;
	}

    record TemperatureSensorAvro {
        string id;
        string hubId;
        timestamp_ms timestamp;
        int temperature_c;
        int temperature_f;
    }

    record ClimateSensorAvro {
        int temperature_c;
        int humidity;
        int co2_level;
    }

    record LightSensorAvro {
        int link_quality;
        int luminosity;
    }

	record SensorEventAvro {
		string id;
		string hubId;
		timestamp_ms timestamp;
		union { SwitchSensorAvro, MotionSensorAvro, ClimateSensorAvro, LightSensorAvro, TemperatureSensorAvro } payload;
	}

}